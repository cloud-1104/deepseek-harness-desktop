{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Desktop shell: an Electron window over the harness web runtime, packaged as Windows and macOS installers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/main.js",
  "license": "MIT",
  "author": "cloud-1104",
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b",
    "dev": "npm run build && electron .",
    "icon": "electron scripts/generate-icon.mjs",
    "prepare-backend": "tsx scripts/prepare-backend.ts",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.7",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
